  {
    "id": "GER_Bormann_Foreign_Policy_Mauritius_and_Reunion",
    "category_id": "GER_Bormann_Foreign_Policy_category",
    "name": "Покорение рая",
    "desc": "С крахом континентальной Германской Африки наша власть над обширными форпостами в Индийском океане была серьёзно ослаблена, что дало японцам возможность беспрепятственно править в южных водах. Несмотря на это, мы, в конечном счёте, всё ещё сохраняем присутствие в регионе, что даёт нам возможность восстановить наши силы. Кригсмарине и связанные с ними воздушные силы готовятся к проведению крупномасштабных военно-морских учений вблизи островов Маврикий и Реюньон близ Мадагаскара.\n\nЕсли они успешно завершат учения, мы сможем лучше противостоять японской агрессии в Индийском океане и впоследствии сосредоточиться на расширении наших баз на этих ключевых островах.",
    "icon": "GFX_decision_generic_military_parade",
    "cost": 0,
    "fire_only_once": true,
    "available": {
      "if": {
        "limit": {
          "is_ai": true
        },
        "always": true
      },
      "else": {
        "ships_in_area": {
          "area": 85,
          "size": {
            "_op": ">",
            "value": 11
          }
        }
      }
    },
    "visible": {
      "has_country_flag": "BOR_JAP_mauritius_reunion_operation_unlocked"
    },
    "complete_effect": {
      "log": "[GetDateText]: [Root.GetName]: Decision GER_Bormann_Foreign_Policy_Mauritius_and_Reunion",
      "hidden_effect": {
        "add_political_power": -50,
        "add_command_power": -25
      }
    }
  },
