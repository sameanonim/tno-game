              }
            ]
          }
        }
      }
    ]
  },
  {
    "id": "spook_news.5",
    "type": "news_event",
    "title": "[Get_newspaper_header]Битва за Гоморру",
    "desc": "После встречи с федеральными чиновниками и чиновниками штата мэр Роберт Ф. Вагнер-младший ввел в Нью-Йорке чрезвычайное положение с 12:00 по восточному времени. Властям всех пяти районов города было предложено принять наихудшие карантинные меры в ответ на \"инциденты, связанные с гражданскими беспорядками\" в Нижнем Манхэттене и прилегающих районах Бруклина. В последний раз всклокоченного мэра и его семью видели въезжающими в Голландский тоннель на кортеже.\n\nРегулярные подразделения армии и Национальной гвардии оцепили Большое яблоко незадолго до приостановки всех неосновных трансляций по всей стране. В тех немногочисленных новостях, которые удалось избежать отключения СМИ, утверждается, что военные разгоняют толпы на контрольно-пропускных пунктах с применением смертоносной силы - утверждение, которое [USA.GetLeader], как ожидается, будет рассмотрено в телевизионном заявлении сегодня вечером.",
    "picture": "GFX_news_event_ZOM_zombie_5",
    "is_superevent": false,
    "is_triggered_only": true,
    "fire_only_once": false,
    "trigger": {
      "NOT": {
        "has_global_flag": "Disable_Zombies"
      }
    },
    "immediate": {
      "log": "[getdatetext]: [root.getname]: event spook_news.5"
    },
    "options": [
      {
        "name": "Что за война приблизилась к нашему берегу...?",
        "name_key": "spook_news.5.a",
        "trigger": {},
        "effects": {
