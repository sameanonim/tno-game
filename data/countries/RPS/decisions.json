  {
    "id": "GER_Speer_ICW_iranisches_freiwilligenkorps",
    "category_id": "GER_BoP_category",
    "name": "Иранский Волонтерский Корпус",
    "desc": "Наш добровольческий корпус, Iranisches Freiwillgenkorps, будет нашим сапогом на этой земле. Опираясь на опыт героического Африканского корпуса, эти люди будут обучены проявлять инициативу, смогут действовать независимо от Фатерлянда и все это без какого-либо намека на субординацию. Они смогут побороть любого врага, что будет стоять перед ними!",
    "icon": "GFX_decision_generic_prepare_civil_war",
    "cost": 0,
    "fire_only_once": true,
    "available": {
      "if": {
        "limit": {
          "has_global_flag": "german_civil_war_speervic"
        },
        "SRT": {
          "exists": false
        }
      }
    },
    "visible": {
      "TNO_fopo_iran_selected": true
    },
    "complete_effect": {
      "log": "[GetDateText]: [Root.GetName]: Decision GER_Speer_ICW_iranisches_freiwilligenkorps",
      "hidden_effect": {
        "add_command_power": -20
      }
    }
  },
  {
    "id": "GER_Speer_ICW_expand_the_iranisches_freiwilligenkorps",
    "category_id": "GER_BoP_category",
    "name": "Расширить Иранский Волонтерский Корпус",
    "desc": "Даже при нашей широкой поддержке война в Иране все еще продолжается. Хотя помощь Рейха и стала решающим звеном, на местах просто не хватает людей, чтобы положить конец этому конфликту. У нас есть много солдат, которые добровольно вызвались сражаться; мы соберем этих нетерпеливых и храбрых людей и пошлем еще больше боевых формирований в Иран, чтобы раз и навсегда покончить с этой войной.",
    "icon": "GFX_decision_generic_prepare_civil_war",
    "cost": 50,
    "fire_only_once": false,
    "available": {
      "set_temp_variable": {
        "target": "PER"
      },
      "TNO_volunteer_cap_less_4": true
    },
    "visible": {
      "TNO_fopo_iran_selected": true,
      "has_country_flag": "GER_iran_volunteers"
    },
    "complete_effect": {
      "log": "[GetDateText]: [Root.GetName]: Decision GER_Speer_ICW_expand_the_iranisches_freiwilligenkorps"
    }
  },
  {
    "id": "DRL_purge_the_officer_corps",
    "category_id": "DRL_Keeping_The_Brigade_Secure",
    "name": "Чистка офицерского корпуса",
    "desc": "Офицеры бригады становятся слишком независимыми, и нельзя допустить, чтобы эта тенденция продолжалась и дальше. Чистка наиболее выдающихся из них должна помочь исправить это, несмотря на то, что это, несомненно, повлияет на боевые операции бригады.",
    "icon": "GFX_decision_generic_civil_support",
