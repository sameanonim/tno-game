  {
    "id": "URL_prepare_raid",
    "category_id": "URL_counter_raids",
    "name": "Подготовка к контр-рейду",
    "desc": "",
    "icon": "GFX_decision_generic_border_war",
    "cost": 0,
    "fire_only_once": false,
    "available": {
      "any_owned_state": {
        "is_fully_controlled_by": "ROOT",
        "has_ROOT_at_least_1_div_in_current_state_scope": true,
        "any_neighbor_state": {
          "OR": {
            "is_fully_controlled_by": [
              "DRL",
              "MGN"
            ]
          }
        }
      },
      "custom_trigger_tooltip": {
        "tooltip": "russia_has_loot_tt",
        "FROM": {
          "check_variable": {
            "loot_amount": {
              "_op": ">",
              "value": 0
            }
          }
        }
      },
      "has_war": false,
      "FROM": {
        "has_war": false
      }
    },
    "visible": {
      "check_variable": {
        "global.stfu_urals": 0
      },
      "NOT": [
        {
          "has_country_flag": "URL_preparing_raid"
        },
        {
          "has_war_with": "FROM",
          "has_border_war_with": "FROM"
        }
      ],
      "FROM": {
        "exists": true
      },
      "has_country_flag": "URL_counter_raids"
    },
    "complete_effect": {
      "log": "[GetDateText]: [Root.GetName]: Decision URL_prepare_raid target: [From.GetName]",
      "hidden_effect": {
        "add_command_power": -50,
        "FROM": {
          "random_owned_controlled_state": {
            "limit": {
              "any_neighbor_state": {
                "is_fully_controlled_by": "ROOT",
                "has_ROOT_at_least_1_div_in_current_state_scope": true
              }
            },
            "set_variable": {
              "PREV.defender_state_vs_@ROOT": "id"
            }
          }
        },
        "random_owned_controlled_state": {
          "limit": {
            "has_ROOT_at_least_1_div_in_current_state_scope": true,
            "any_neighbor_state": {
              "is_fully_controlled_by": "FROM"
            }
          },
          "set_variable": {
            "FROM.attacker_state_vs_@ROOT": "id"
          }
        },
        "set_country_flag": "URL_preparing_raid"
      }
    }
  },
  {
    "id": "URL_initiate_raid",
    "category_id": "URL_counter_raids",
    "name": "Инициировать контр-рейд",
    "desc": "",
    "icon": "GFX_decision_generic_border_war",
    "cost": 0,
    "fire_only_once": true,
    "available": {
      "ROOT": {
        "var:FROM.attacker_state_vs_@ROOT": {
          "is_fully_controlled_by": "ROOT"
        }
      },
      "divisions_in_border_state": {
        "state": "var:FROM.attacker_state_vs_@ROOT",
        "border_state": "var:FROM.defender_state_vs_@ROOT",
        "size": {
          "_op": ">",
          "value": 0
        }
      }
    },
    "visible": {},
    "complete_effect": {
      "log": "[GetDateText]: [Root.GetName]: Decision URL_initiate_raid",
      "if": [
        {
          "limit": {
            "FROM": {
              "original_tag": "DRL"
            }
          },
          "start_border_war": {
            "change_state_after_war": false,
            "attacker": {
              "state": "var:FROM.attacker_state_vs_@ROOT",
              "num_provinces": 4,
              "on_win": "raiding.1",
              "on_lose": "raiding.3",
              "on_cancel": "raiding.2"
            },
            "defender": {
              "state": "var:FROM.defender_state_vs_@ROOT",
              "num_provinces": 4,
              "on_win": "raiding.103",
              "on_lose": "raiding.105",
              "on_cancel": "raiding.104"
            }
          }
        },
        {
          "limit": {
            "FROM": {
              "NOT": {
                "original_tag": [
                  "ORE",
                  "URL",
                  "MGN"
                ]
              }
            }
          },
          "add_to_variable": {
            "ORE_non_ural_raiding": 1
          }
        }
      ],
      "else_if": {
        "limit": {
          "FROM": {
            "original_tag": "MGN"
          }
        },
        "start_border_war": {
          "change_state_after_war": false,
          "attacker": {
            "state": "var:FROM.attacker_state_vs_@ROOT",
            "num_provinces": 4,
            "on_win": "raiding.106",
            "on_lose": "raiding.108",
            "on_cancel": "raiding.107"
          },
          "defender": {
            "state": "var:FROM.defender_state_vs_@ROOT",
            "num_provinces": 4,
            "on_win": "raiding.109",
            "on_lose": "raiding.111",
            "on_cancel": "raiding.110"
          }
        }
      },
      "hidden_effect": {
        "remove_targeted_decision": {
          "target": "FROM",
          "decision": "URL_initiate_raid"
        },
        "activate_targeted_decision": {
          "target": "FROM",
          "decision": "URL_raid_in_progress"
        }
      }
    }
  },
