      "TNO_Espionage_NoSpecialMission": true
    },
    "visible": {
      "AND": {
        "OR": {
          "TNO_Espionage_Viewing_Europe": true,
          "is_ai": true
        },
        "IBR": {
          "has_country_flag": "IBR_Terrorism_GUI",
          "NOT": {
            "AND": {
              "has_country_flag": [
                "IBR_CNT_Broken",
                "IBR_ETA_Broken",
                "IBR_BTA_Broken",
                "IBR_FSLP_Broken"
              ]
            }
          }
        },
        "NOT": [
          {
            "has_global_flag": "IBW_happening"
          },
          {
            "has_global_flag": "Iberian_Divorce"
          }
        ]
      }
    },
    "complete_effect": {
      "custom_effect_tooltip": "USA_CIA_IBR_aas_aid",
      "set_country_flag": "TNO_Espionage_DoingSpecialMission",
      "set_temp_variable": {
        "RegionID": "@Europe"
      },
      "random_list": {
        "TNO_Espionage_MissionSuccess^RegionID": {
          "custom_effect_tooltip": "TNO_Espionage_MissionSuccess_tt",
          "set_country_flag": "USA_CIA_Add_AAS_Resources",
          "hidden_effect": {
            "country_event": {
              "id": "USA_CIA.3",
              "days": 14
            }
          }
        },
        "TNO_Espionage_MissionFailure^RegionID": {
          "custom_effect_tooltip": "TNO_Espionage_MissionFailure_tt",
          "hidden_effect": {
            "country_event": {
              "id": "USA_CIA.2",
              "days": 14
            }
          }
        }
      },
      "subtract_from_variable": [
        {
          "TNO_Espionage_Budget": 0.015
        },
        {
          "TNO_Espionage_Agents": 1
        }
      ],
      "add_to_variable": {
        "IBR.IBR_OFN_Alignment": 1
      }
    }
  },
  {
    "id": "GER_Espionage_aid_the_aas",
    "category_id": "GER_BoP_category",
    "name": "Операция \"Кондор\"",
    "desc": "Для такого ублюдочного государства, как Иберия, Франко и Салазар заслужили некоторое уважение своей силой воли и решимостью сохранить свое государство в живых. Было бы поистине обидно, если Иберия попадет в руки сепаратистов, особенно тех, которые, кажется, склонны к красной идеологии. Чтобы не дать призраку большевизма вернуться в Европу, мы пошлем оперативников для противостояния этим сепаратистам и их коварным заговорам, что даст преимущество иберийским силам. Кроме того, тем самым, возможно, мы наконец сможем убедить иберийцев в том, что Рейх является союзником, а не угрозой.",
    "icon": "GFX_decision_GER_espionage",
    "cost": 0,
    "fire_only_once": true,
    "available": {
      "TNO_Espionage_AgentsAvailable": true,
      "TNO_Espionage_NoSpecialMission": true
    },
    "visible": {
      "OR": {
        "TNO_Espionage_Viewing_Europe": true,
        "is_ai": true
      },
      "NOT": {
        "has_global_flag": "IBW_happening"
      },
      "IBR": {
        "has_country_flag": "IBR_Terrorism_GUI"
      }
    },
    "complete_effect": {
      "log": "[GetDateText]: [Root.GetName]: Decision GER_Espionage_aid_the_aas",
      "hidden_effect": {
        "subtract_from_variable": [
          {
            "TNO_Espionage_Budget": 0.05
          },
          {
            "TNO_Espionage_Expertise": 20
          },
          {
            "TNO_Espionage_Agents": 1
          }
        ]
      },
      "set_country_flag": "TNO_Espionage_DoingSpecialMission"
    }
  },
