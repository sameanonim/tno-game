      "TNO_improve_public_meetings_policy_effectiveness_low": true,
      "econ_spend_money_once_effect_raw_money": true,
      "add_dynamic_modifier": {
        "modifier": "AMR_labor_unto_redemption_dynamic_modifier"
      },
      "add_to_variable": {
        "AMR_rodz_econ_pop_debuff": -0.02
      },
      "custom_effect_tooltip": "AMR_rodz_worsen_pop_growth",
