[
  {
    "id": "SEA_china_improvement.1",
    "type": "country_event",
    "title": "Новый офицерский выпуск",
    "desc": "Белоснежные рубашки и начищенные ботинки, блестящие в лучах яркого солнца. Они стоят стройными рядами и слушают, как [ROOT.GetLeader] выступает с речью в честь их выпускного. Скоро они отправятся на фронт и будут прославлять [ROOT.GetNameRuAcc].",
    "picture": "GFX_report_event_chinese_soldiers",
    "is_superevent": false,
    "is_triggered_only": true,
    "fire_only_once": false,
    "trigger": {},
    "immediate": {},
    "options": [
      {
        "name": "Добровольцы идут к славе.",
        "name_key": "SEA_china_improvement.1.a",
        "trigger": {},
        "effects": {
          "custom_effect_tooltip": [
            "CHI_modify_corruption_in_the_armed_forces_tt",
            "SEA_china_improvement.1_tt"
          ],
          "add_to_variable": {
            "CHI_corruption_in_the_armed_forces_conscription_factor": "CHI_corruption_in_the_armed_forces_conscription_factor_improvement",
