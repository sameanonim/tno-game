          },
          "hidden_effect": {
            "country_event": {
              "id": "SEA_china_improvement.4",
              "months": 6
            }
          }
        }
      }
    ]
  },
  {
    "id": "SEA_china_improvement.2",
    "type": "country_event",
    "title": "Искоренение источника отравы",
    "desc": "Понимая, что торговля опиумом подрывает авторитет государства и доверие народа, мы должны начать долгосрочную кампанию по борьбе с опиумными синдикатами. Ни более строгие проверки, ни кадровые перестановки, ни информирование населения не принесут плодов сразу, но со временем все эти меры ослабят тайную сеть, паразитирующую на [CHI.GetAdjRuLower]ой слабости.",
    "picture": "GFX_report_event_chinese_soldiers_running",
    "is_superevent": false,
    "is_triggered_only": true,
    "fire_only_once": false,
    "trigger": {},
    "immediate": {},
    "options": [
      {
        "name": "Борьба будет долгой, но мы не отступим.",
        "name_key": "SEA_china_improvement.2.a",
        "trigger": {},
        "effects": {
          "custom_effect_tooltip": [
            "CHI_modify_illicit_trade_tt",
            "SEA_china_improvement.2_tt"
          ],
          "IF": [
            {
              "limit": {
                "check_variable": {
                  "CHI_illicit_trade_consumer_goods": {
                    "_op": "<",
                    "value": 0
                  }
                }
              },
              "add_to_variable": {
                "CHI_illicit_trade_consumer_goods": "var:illicit_goods_reduction_step",
                "tooltip": "consumer_goods_factor_tt"
              }
            },
            {
              "limit": {
                "check_variable": {
                  "var": "CHI_illicit_trade_industrial_capacity_factory",
                  "value": 0,
                  "compare": "less_than"
                }
              },
              "add_to_variable": {
                "CHI_illicit_trade_industrial_capacity_factory": "var:illicit_goods_reduction_step",
                "tooltip": "industrial_capacity_factory_tt"
              }
            },
            {
              "limit": {
                "check_variable": {
                  "var": "CHI_illicit_trade_industrial_capacity_dockyard",
                  "value": 0,
                  "compare": "less_than"
                }
              },
              "add_to_variable": {
                "CHI_illicit_trade_industrial_capacity_dockyard": "var:illicit_goods_reduction_step",
                "tooltip": "industrial_capacity_dockyard_tt"
              }
            }
          ],
          "hidden_effect": {
            "country_event": {
              "id": "SEA_china_improvement.5",
              "months": 6,
              "random_days": 10
            }
          }
        }
      }
    ]
  },
  {
    "id": "SEA_china_improvement.3",
    "type": "country_event",
    "title": "Победа над пороком",
    "desc": "После многих лет постоянных реформ, тихих чисток и неусыпной бдительности нам удалось сокрушить последнюю из крупных сетей торговли опиумом. Впервые за десятилетия воля государства исполняется даже в самых глухих уголках страны. Циники ворчат о старых временах, но даже они отмечают, что воздух стал чище.",
