  {
    "id": "DRL_dirly_prepare_raid",
    "category_id": "DRL_Raiding",
    "name": "Подготовьте рейд против [From.GetName]!",
    "desc": "Армии этих ублюдков слишком малы, чтобы обеспечить безопасность каждого города. Мы просто не можем упустить такую возможность!",
    "icon": "GFX_decision_generic_border_war",
    "cost": 0,
    "fire_only_once": false,
    "available": {
      "any_owned_state": {
        "is_fully_controlled_by": "ROOT",
        "has_ROOT_at_least_1_div_in_current_state_scope": true,
        "any_neighbor_state": {
          "is_fully_controlled_by": "FROM"
        }
      },
      "NOT": [
        {
          "has_country_flag": "DRL_dirly_raid_succeeded"
        },
        {
          "has_country_flag": "DRL_dirly_raid_failed"
        },
        {
          "has_idea": "URL_cannot_raid"
        },
        {
          "FROM": {
            "is_ally_with": "ROOT"
          }
        }
      ],
      "has_war": false,
      "FROM": {
        "has_war": false
      }
    },
    "visible": {
      "NOT": {
        "has_country_flag": "DRL_dirly_preparing_raid",
        "has_border_war_with": "FROM",
        "has_non_aggression_pact_with": "FROM"
      },
      "is_neighbor_of": "FROM"
    },
    "complete_effect": {
      "log": "[GetDateText]: [Root.GetName]: Decision DRL_dirly_prepare_raid target: [From.GetName]",
      "hidden_effect": {
        "add_command_power": -20,
        "FROM": {
          "random_owned_controlled_state": {
            "limit": {
              "any_neighbor_state": {
                "is_fully_controlled_by": "ROOT",
                "has_ROOT_at_least_1_div_in_current_state_scope": true
              }
            },
            "set_variable": {
              "PREV.defender_state_vs_@ROOT": "id"
            }
          }
        },
        "random_owned_controlled_state": {
          "limit": {
            "has_ROOT_at_least_1_div_in_current_state_scope": true,
            "any_neighbor_state": {
              "is_fully_controlled_by": "FROM"
            }
          },
          "set_variable": {
            "FROM.attacker_state_vs_@ROOT": "id"
          }
        },
        "set_country_flag": "DRL_dirly_preparing_raid"
      }
    }
  },
  {
    "id": "DRL_dirly_initiate_raid",
    "category_id": "DRL_Raiding",
    "name": "Разграбить и сжечь!",
    "desc": "Время пришло! Возьмите все, что мы хотим взять и сожгите все, что мы не унесем.",
    "icon": "GFX_decision_generic_border_war",
    "cost": 0,
    "fire_only_once": true,
    "available": {
      "ROOT": {
        "var:FROM.attacker_state_vs_@ROOT": {
          "is_fully_controlled_by": "ROOT"
        }
      },
      "divisions_in_border_state": {
        "state": "var:FROM.attacker_state_vs_@ROOT",
        "border_state": "var:FROM.defender_state_vs_@ROOT",
        "size": {
          "_op": ">",
          "value": 0
        }
      }
    },
    "visible": {},
    "complete_effect": {
      "log": "[GetDateText]: [Root.GetName]: Decision DRL_dirly_initiate_raid",
      "start_border_war": {
        "change_state_after_war": false,
        "attacker": {
          "state": "var:FROM.attacker_state_vs_@ROOT",
          "num_provinces": 4,
          "on_win": "raiding.1",
          "on_lose": "raiding.3",
          "on_cancel": "raiding.2"
        },
        "defender": {
          "state": "var:FROM.defender_state_vs_@ROOT",
          "num_provinces": 4,
          "on_win": "raiding.6",
          "on_lose": "raiding.4",
          "on_cancel": "raiding.5"
        }
      },
      "if": {
        "limit": {
          "FROM": {
            "NOT": {
              "original_tag": [
                "ORE",
                "URL",
                "MGN"
              ]
            }
          }
        },
        "add_to_variable": {
          "ORE_non_ural_raiding": 1
        }
      },
      "hidden_effect": {
        "remove_targeted_decision": {
          "target": "FROM",
          "decision": "DRL_dirly_initiate_raid"
        },
        "activate_targeted_decision": {
          "target": "FROM",
          "decision": "DRL_dirly_raid_in_progress"
        }
      }
    }
  },
