  {
    "id": "USA_CIA_Align_Iberia_Towards_Salazar",
    "category_id": "USA_BoP_category",
    "name": "Поддержать [GetIBR_Portuguese_Caudillo][GetPOR_Caudillo_rod_pad]",
    "desc": "",
    "icon": "GFX_decision_generic_chess_king",
    "cost": 0,
    "fire_only_once": false,
    "available": {
      "custom_trigger_tooltip": {
        "tooltip": "USA_CIA_Mission_Cost_25_Million",
        "check_variable": {
          "TNO_Espionage_Budget": {
            "_op": ">",
            "value": 0.024
          }
        }
      },
      "TNO_Espionage_AgentsAvailable": true,
      "TNO_Espionage_NoSpecialMission": true
    },
    "visible": {
      "AND": {
        "OR": {
          "TNO_Espionage_Viewing_Europe": true,
          "is_ai": true
        },
        "NOT": {
          "IBR": {
            "has_country_flag": "IBR_caudillo_mechanic_over"
          },
          "has_country_flag": [
            "USA_CIA_Iberia_Franco_Align_success",
            "USA_CIA_Iberia_Salazar_Align_success"
          ],
          "has_global_flag": "IBW_happening"
        },
        "IBR": {
          "has_country_flag": "IBR_caudillo_mechanic_started"
        }
      }
    },
    "complete_effect": {
      "if": {
        "limit": {
          "IBR": {
            "has_country_flag": "IBR_caetano_springboard"
          }
        },
        "custom_effect_tooltip": "USA_CIA_IBR_align_caudillo_salazar_2"
      },
      "else": {
        "custom_effect_tooltip": "USA_CIA_IBR_align_caudillo_salazar"
      },
      "set_country_flag": "TNO_Espionage_DoingSpecialMission",
      "set_temp_variable": {
        "RegionID": "@Europe"
      },
      "random_list": {
        "TNO_Espionage_MissionSuccess^RegionID": {
          "custom_effect_tooltip": "TNO_Espionage_MissionSuccess_tt",
          "set_country_flag": "USA_CIA_Iberia_Salazar_Align",
          "hidden_effect": {
            "country_event": {
              "id": "USA_CIA.3",
              "days": 14
            }
          }
        },
        "TNO_Espionage_MissionFailure^RegionID": {
          "custom_effect_tooltip": "TNO_Espionage_MissionFailure_tt",
          "hidden_effect": {
            "country_event": {
              "id": "USA_CIA.2",
              "days": 14
            }
          }
        }
      },
      "clr_country_flag": "CIA_AI_EUROPE_IBR_SALAZAR",
      "subtract_from_variable": [
        {
          "TNO_Espionage_Budget": 0.025
        },
        {
          "TNO_Espionage_Agents": 1
        }
      ],
      "add_to_variable": {
        "IBR.IBR_OFN_Alignment": 1
      }
    }
  },
