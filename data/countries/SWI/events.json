          "custom_effect_tooltip": "SWI_frankfurter_trial_will_continue_TT",
          "hidden_effect": {
            "set_country_flag": "SWI_prepare_for_trial"
          }
        }
      },
      {
        "name": "Замести следы и завербовать его в агенты!",
        "name_key": "BBA_switzerland.2.b",
        "trigger": {
          "has_intelligence_agency": true,
          "has_dlc": "La Resistance"
        },
        "effects": {
          "SWI_create_david_frankfurter_operative": true,
          "hidden_effect": {
            "set_country_flag": "SWI_faked_frankfurters_death"
          },
          "if": {
            "limit": {
              "SWI_fascist_germany_exists": true
            },
            "random_list": {
              "70": {
                "var:SWI.SWI_fascist_germany": {
                  "country_event": {
                    "id": "BBA_switzerland.9",
                    "hours": 4
                  },
                  "effect_tooltip": {
                    "add_opinion_modifier": {
                      "modifier": "SWI_recruited_assasin_as_agent",
                      "target": "SWI"
                    }
                  }
                }
              },
              "30": {
                "var:SWI.SWI_fascist_germany": {
                  "country_event": {
                    "id": "BBA_switzerland.7",
                    "hours": 4
                  },
                  "add_opinion_modifier": {
                    "modifier": "SWI_suspicions_of_coverup",
                    "target": "SWI"
                  }
                }
              }
            }
          },
          "SWI_update_neighbor_opinion_balance": true
        }
      },
      {
        "name": "Он признался — значит, должен немедленно получить максимальный срок.",
        "name_key": "BBA_switzerland.2.c",
        "trigger": [],
        "effects": {
          "custom_effect_tooltip": "SWI_frankfurter_immediate_harsh_sentence_TT",
          "Hidden_effect": {
            "set_country_flag": "SWI_frankfurter_immediate_harsh_sentence"
          },
          "var:SWI.SWI_fascist_germany": {
            "add_opinion_modifier": {
              "modifier": "SWI_swift_retribution_for_gustloff",
              "target": "SWI"
            }
          },
          "every_other_country": {
            "limit": {
              "SWI_is_country_to_balance": true,
              "has_government": "democratic"
            },
            "add_opinion_modifier": {
              "target": "SWI",
              "modifier": "SWI_too_harsh_on_frankfurter"
            }
          },
          "SWI_update_neighbor_opinion_balance": true
        }
      }
    ]
  },
  {
    "id": "BBA_switzerland.3",
    "type": "country_event",
    "title": "Близится суд над Давидом Франкфуртером",
    "desc": "Скоро состоится суд над Давидом Франкфуртером, убившим в феврале представителя нацистской партии в Давосе. Мы обещали ему справедливый и беспристрастный суд, но есть, разумеется, и другие варианты.\n\nМы могли бы тайно освободить его и завербовать для разведопераций; или можно умаслить [?SWI.SWI_fascist_germany.GetNameRuAcc], отменив суд и сразу вынеся приговор.\n\nКак бы мы ни поступили, удовлетворить сразу все стороны будет невозможно.",
