# ==============================================================================
# GODOT 4 ENGINE & BUILD ARTIFACTS
# ==============================================================================
# Engine import cache and internal metadata
.godot/
.import/
*.import
*.translation
export_presets.cfg

# Preserve essential project icons and font import descriptors
!icon.svg
!icon.svg.import
!addons/godot_mcp_toolkit/icon.svg
!addons/godot_mcp_toolkit/icon.svg.import
!assets/fonts/*.import

# Export binaries, builds and platform packages
export/
exports/
build/
builds/
bin/
*.exe
*.pck
*.apk
*.aab
*.ipa
*.app/
*.dmg
*.msi
*.deb
*.rpm
*.pkg
*.dll
*.so
*.dylib
/android/
/ios/

# Mono / C# (if used)
.mono/
[Bb]in/
[Oo]bj/

# ==============================================================================
# БОЛЬШИЕ ФАЙЛЫ ДАННЫХ И БАЗЫ ДАННЫХ (LARGE DATA & DATABASES)
# ==============================================================================
# SQLite базы данных (локализация, страны, игровой кэш - сотни МБ/ГБ)
*.sqlite
*.sqlite3
*.db
*.s3db
*.sl3

# Журналы транзакций и WAL файлы SQLite (согласно правилам разработки)
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db-journal
*.db-wal
*.db-shm

# Тяжелые дампы данных и выгрузки локализации (localization_db.json > 360 МБ)
localization_db.json
**/localization_db.json
data/localization/localization_db.json
data/localization/*.bin
pipeline/db/*.sqlite
pipeline/db/*.sqlite3
pipeline/db/*.db
pipeline/db/*.dump
pipeline/tno_exporter.exe
tno_exporter.exe

# Снапшоты, дампы памяти, дампы крашей и профилировщика
*.dump
*.dmp
*.stackdump
*.trace
*.prof

# ==============================================================================
# АРХИВЫ И СЖАТЫЕ ПАКЕТЫ (ARCHIVES)
# ==============================================================================
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.bz2
*.xz
*.iso
*.cab

# ==============================================================================
# МЕДИА: ВИДЕО И АНИМАЦИЯ (VIDEO)
# ==============================================================================
*.mp4
*.mkv
*.avi
*.mov
*.webm
*.flv
*.wmv
*.m4v

# ==============================================================================
# МЕДИА: ИЗОБРАЖЕНИЯ, ТЕКСТУРЫ И ИСХОДНИКИ (IMAGES & GRAPHICS)
# ==============================================================================
# Растровые и текстурные форматы
*.png
*.jpg
*.jpeg
*.webp
*.bmp
*.tga
*.dds
*.gif
*.tiff
*.tif
*.hdr
*.exr
*.ico

# Векторная графика и исходники графических редакторов (Photoshop, Aseprite и др.)
*.svg
*.psd
*.psb
*.ai
*.kra
*.xcf
*.clip
*.ase
*.aseprite

# ==============================================================================
# МЕДИА: 3D МОДЕЛИ И СЦЕНЫ (3D ASSETS)
# ==============================================================================
*.blend
*.blend1
*.fbx
*.obj
*.dae
*.3ds
*.max
*.c4d
*.mb
*.ma

# ==============================================================================
# МЕДИА: МУЗЫКА И ЗВУКИ (AUDIO & MUSIC)
# ==============================================================================
*.ogg
*.wav
*.mp3
*.flac
*.aac
*.m4a
*.wma
*.opus
*.mid
*.midi
*.bank
*.fsb
*.mod
*.xm
