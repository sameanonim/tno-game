*.it
*.aiff

# ==============================================================================
# ПОЛЬЗОВАТЕЛЬСКИЕ ДАННЫЕ, СОХРАНЕНИЯ И ЛОГИ (SAVES & LOGS)
# ==============================================================================
user/
user://
savegame.json
*.save
*.sav
*.log
logs/
*.crash

# ==============================================================================
# PYTHON PIPELINE, ТЕСТОВЫЙ КЭШ И ВИРТУАЛЬНЫЕ ОКРУЖЕНИЯ
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/
ENV/
*.egg-info/
pip-wheel-metadata/
dist/

# Временные скрипты и отчеты аудита
audit_*.json
*.jsonl
tmp/
temp/
scratch/

# ==============================================================================
# ОПЕРАЦИОННАЯ СИСТЕМА И РЕДАКТОРЫ КОДА (OS & IDE)
# ==============================================================================
