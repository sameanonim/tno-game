[gd_scene format=3 uid="uid://ita_terminal_sc_01"]

[ext_resource type="Script" path="res://ui/screens/italy/italy_terminal_screen.gd" id="1_ita"]

[node name="ItalyTerminalScreen" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_ita")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="HeaderHBox" type="HBoxContainer" parent="VBox"]
layout_mode = 2

[node name="TitleLabel" type="Label" parent="VBox/HeaderHBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.95, 0.85, 1)
theme_override_font_sizes/font_size = 14
text = "=== РЕЙНО Д'ИТАЛИЯ // ВЕЛИКИЙ СОВЕТ И СРЕДИЗЕМНОМОРЬЕ ==="

[node name="Spacer" type="Control" parent="VBox/HeaderHBox"]
layout_mode = 2
size_flags_horizontal = 3

[node name="CloseButton" type="Button" parent="VBox/HeaderHBox"]
custom_minimum_size = Vector2(140, 28)
layout_mode = 2
text = "[ ✕ ЗАКРЫТЬ ]"

[node name="TopHUD" type="PanelContainer" parent="VBox"]
layout_mode = 2

[node name="HBox" type="HBoxContainer" parent="VBox/TopHUD"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="DuceLabel" type="Label" parent="VBox/TopHUD/HBox"]
