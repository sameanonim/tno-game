[gd_scene format=3 uid="uid://jap_terminal_sc_01"]

[ext_resource type="Script" path="res://ui/screens/japan/japan_terminal_screen.gd" id="1_jap"]

[node name="JapanTerminalScreen" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_jap")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="HeaderHBox" type="HBoxContainer" parent="VBox"]
layout_mode = 2

[node name="TitleLabel" type="Label" parent="VBox/HeaderHBox"]
