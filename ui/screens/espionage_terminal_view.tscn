[gd_scene format=3 uid="uid://espionage_terminal_001"]

[ext_resource type="Script" path="res://ui/screens/espionage_terminal_view.gd" id="1_esp"]

[node name="EspionageTerminalView" type="PanelContainer"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -480.0
offset_top = -300.0
offset_right = 480.0
offset_bottom = 300.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_esp")

[node name="VBox" type="VBoxContainer" parent="."]
